# ==============================================================================
# SENSORA – External API Integrations Configuration Template
# ==============================================================================
# Copy this file to .env and insert your API credentials.
# All integrations feature graceful fallbacks: if an API key is omitted,
# SENSORA operates smoothly with simulated high-fidelity telemetry.

# 1. DATABASE CONFIGURATION (PostgreSQL, Supabase, Neon, or SQLite)
# Default: Local SQLite database
DATABASE_URL=sqlite:///./sensora.db
# Example Supabase/PostgreSQL:
# DATABASE_URL=postgresql://postgres:your_password@db.supabase.co:5432/postgres

# 2. TWILIO EMERGENCY SMS & CALL BROADCAST
# Sign up at: https://www.twilio.com
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890
EMERGENCY_DISPATCH_PHONE=+977-9800000000

# 3. LORAWAN GATEWAY & UPLINK WEBHOOK (The Things Network v3 / ChirpStack)
# Console: https://eu1.cloud.thethings.network/
LORAWAN_APP_KEY=your_ttn_app_key
LORAWAN_API_KEY=NNSXS.your_ttn_api_key
LORAWAN_WEBHOOK_SECRET=your_webhook_signing_secret

# 4. MQTT BROKER FOR ESP32 FIELD NODES
MQTT_BROKER_HOST=broker.hivemq.com
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=sensora/nepal/catchment/telemetry

# 5. GOOGLE MAPS PLATFORM API
# Console: https://console.cloud.google.com/google/maps-apis/credentials
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# 6. OPENWEATHERMAP API (Live Melamchi Synoptic Weather)
# Sign up at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key

# 7. SATELLITE EARTH OBSERVATION API (Copernicus / NASA Earthdata)
SATELLITE_API_KEY=your_satellite_service_key

# 8. GOOGLE GEMINI 1.5 FLASH AI SITREP ENGINE
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key_optional
